#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Junta numa saída só as evidências que a Fase 1 pede da VM (docs/TESTS.md F1-05/F1-06).
# Uso: sudo luma-diagnostico      (grava também /var/tmp/luma-diagnostico.txt)
set -uo pipefail
[ "$(id -u)" = 0 ] || { echo "execute com sudo: sudo luma-diagnostico" >&2; exit 77; }
out=/var/tmp/luma-diagnostico.txt
user="${SUDO_USER:-}"
sec() { printf '\n== %s ==\n' "$1"; }
run() { "$@" 2>&1 || echo "(falhou: $*)"; }
{
	echo "luma-diagnostico $(date -u +%FT%TZ)"
	sec "sistema"; run grep -E '^(NAME|PRETTY_NAME|ID|VERSION|IMAGE_VERSION|DEFAULT_HOSTNAME)=' /usr/lib/os-release
	sec "hostname"; run hostnamectl --static
	sec "selinux"; run getenforce
	sec "secure boot"; if command -v mokutil >/dev/null; then run mokutil --sb-state; else run bootctl status --no-pager; fi
	sec "firewall: zona padrão"; run firewall-cmd --get-default-zone
	sec "firewall: zona ativa"; run firewall-cmd --get-active-zones
	sec "firewall: zona luma"; run firewall-cmd --zone=luma --list-all
	sec "portas abertas (escuta)"; run ss -tulnH
	sec "bootc"; run bootc status
	sec "logos"; run rpm -q fedora-logos generic-logos
	if [ -n "$user" ]; then
		sec "tema do usuário $user"
		run sudo -u "$user" kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage
		run sudo -u "$user" kreadconfig6 --file kdeglobals --group General --key ColorScheme
	fi
} | tee "$out"
echo; echo "salvo em $out"
