# Imagem de instalador para o tipo bootc-installer do image-builder (decisão 0011):
# a própria imagem Luma acrescida do Anaconda, que é quem roda no boot da ISO e instala a imagem-carga
# (--bootc-installer-payload-ref). Padrão documentado pelo osbuild ("FROM <bootc> + dnf install anaconda").
# Os pacotes exatos que o Anaconda exige no Fedora 44 são hipótese [H]; o CI confirma ou derruba.
ARG LUMA_IMAGE=localhost/luma:44
# Mesmo digest do TOOLS_DIGEST do Containerfile (F6-08; scripts/ci/atualizar-base.sh --gravar troca os dois)
ARG TOOLS_IMAGE=quay.io/fedora/fedora:44@sha256:4688bc8003a1a6a7815e5f9d1f1b5c6bc9cafa582654af7cec61435d91655e3b

# Marca Luma no Anaconda (F6-05): imagens rasterizadas aqui, sem levar o rsvg-convert para o instalador
FROM ${TOOLS_IMAGE} AS marca
RUN dnf -y install librsvg2-tools && dnf clean all
COPY installer/ /src/installer/
COPY icons/ /src/icons/
RUN /src/installer/anaconda/build.sh /src /out

FROM ${LUMA_IMAGE}
# dnf5 em build de imagem Atomic é esperado no Fedora 44 [H]; sem ele, rpm-ostree instala o mesmo conjunto
RUN pkgs='anaconda anaconda-install-env-deps anaconda-dracut'; \
    if command -v dnf >/dev/null; then dnf -y install $pkgs && dnf clean all; else rpm-ostree install $pkgs; fi
# Evidência: o que havia em pixmaps e quais imagens o CSS do Anaconda usa (os nomes são [H] até este log)
# (iso #28: o CSS não está em /usr/share/anaconda; procura em /usr inteiro)
RUN css="$(find /usr -name 'anaconda-gtk*.css' 2>/dev/null | tr '\n' ' ')"; echo "luma: CSS do Anaconda: ${css:-nenhum}"; \
    echo "luma: pixmaps antes: $(ls /usr/share/anaconda/pixmaps 2>/dev/null | tr '\n' ' ')"; \
    [ -z "$css" ] || echo "luma: imagens citadas no CSS: $(grep -hoE 'pixmaps/[A-Za-z0-9_-]+\.png' $css | sort -u | tr '\n' ' ')"; \
    [ -z "$css" ] || sed -n '85,135p' $css | sed 's/^/luma: css: /'; \
    echo "luma: folhas de estilo e perfis: $(find /usr/share/anaconda /etc/anaconda -name '*.css' -o -name '*.conf' 2>/dev/null | tr '\n' ' ')"; \
    grep -rns 'stylesheet' /etc/anaconda /usr/share/anaconda 2>/dev/null | head -n 20 | sed 's/^/luma: perfil: /'
# O image-builder (tipo bootc-installer) monta o boot da ISO com o shim e o GRUB de /boot/efi do instalador
# (iso #31: "No such file or directory: '/boot/efi/EFI/fedora/shimx64.efi'"). Na imagem bootc eles ficam fora de
# /boot (iso #32: /usr/lib/bootupd/updates/EFI não trouxe nada); [H] no Fedora 44, em /usr/lib/efi/<pacote>/<versão>/EFI.
# iso #33: depois do shim, falta o GRUB de CD (gcdx64.efi, pacote grub2-efi-x64-cdboot)
# iso #34: depois do EFI, o osbuild falhou com "No module named 'mako'" (modelos do lorax que montam a ISO).
# [H] Lista de pacotes do instalador para o bootc-installer, conforme a doc do osbuild; os que não existirem são pulados.
# instalador-ib #1: aos 420 s o Anaconda ainda dizia "Starting installer" e a interface gráfica não abriu. [H] No
# Fedora 44 ela roda sobre o gnome-kiosk (Wayland), que a base KDE não traz; só no instalador, nunca no sistema.
# instalador-ib #10: o run-in-new-session (que sobe o gnome-kiosk) parou em "No module named 'pam'"; ele também usa
# systemd.journal. Os módulos Python entram junto, só no instalador.
RUN dnf -y install --skip-unavailable anaconda-gui gnome-kiosk python3-pam python3-systemd && dnf clean all \
    || echo "luma: AVISO: anaconda-gui/gnome-kiosk não instalaram"
# Confere os imports do run-in-new-session: se faltar um, o instalador cai no modo texto. EXIGIR_GUI=1 (workflow
# instalador-ib) falha o build; no iso.yml (ISO do bib, que não usa esta interface) só avisa.
ARG EXIGIR_GUI=0
RUN s=/usr/libexec/anaconda/run-in-new-session; falha() { echo "luma: $1" >&2; [ "$EXIGIR_GUI" = 1 ] && exit 1; }; \
    [ -r "$s" ] || falha "$s ausente"; \
    [ -r "$s" ] && for m in $(sed -nE 's/^(import|from) ([A-Za-z_][A-Za-z0-9_.]*).*/\2/p' "$s" | sort -u); do \
      python3 -c "import $m" 2>/dev/null || falha "o instalador gráfico não vai abrir: falta o módulo Python $m"; \
    done; echo "luma: conferência dos imports do run-in-new-session terminada"
# instalador-ib #11: a interface saiu em inglês com "lang pt_BR.UTF-8" no kickstart; registra se a tradução existe aqui
RUN echo "luma: traduções pt_BR do Anaconda: $(ls /usr/share/locale/pt_BR/LC_MESSAGES/anaconda*.mo 2>/dev/null | tr '\n' ' ' || true)"; \
    ls /usr/share/locale/pt_BR/LC_MESSAGES/anaconda*.mo >/dev/null 2>&1 || echo "luma: AVISO: traduções pt_BR do Anaconda AUSENTES"
# instalador-ib #13: com inst.lang=pt_BR o Anaconda ainda escolheu en_US; registra se o locale existe na imagem
RUN echo "luma: locales pt no instalador (antes do osbuild): $(locale -a 2>/dev/null | grep -i '^pt' | tr '\n' ' ')"
# instalador-ib #14: o pt_BR existe e o Anaconda o aceita, mas o locale.conf do instalador vira LANG=C.UTF-8 no osbuild
# e a interface sai em en_US mesmo com inst.lang no boot. [H] O Anaconda herda o LANG do serviço: só no instalador.
RUN mkdir -p /etc/systemd/system/anaconda.service.d && \
    printf '[Service]\nEnvironment=LANG=pt_BR.UTF-8\n' >/etc/systemd/system/anaconda.service.d/50-luma-idioma.conf
RUN dnf -y install --skip-unavailable grub2-efi-x64-cdboot python3-mako lorax-templates-generic squashfs-tools \
      dracut-config-generic dracut-network net-tools prefixdevname biosdevname && dnf clean all \
    || echo "luma: AVISO: pacotes do instalador para o image-builder não instalaram"
RUN echo "luma: arquivos EFI na imagem: $(find /usr/lib/bootupd /usr/lib/efi -type f 2>/dev/null | head -n 40 | tr '\n' ' ')"; \
    find /usr/lib/efi /usr/lib/bootupd/updates -type f -path '*/EFI/*' 2>/dev/null | while read -r f; do \
      dest="/boot/efi/EFI/${f#*/EFI/}"; mkdir -p "$(dirname "$dest")"; cp -n "$f" "$dest"; \
    done; \
    echo "luma: EFI do instalador: $(find /boot/efi/EFI -type f 2>/dev/null | tr '\n' ' ')"; \
    for f in shimx64.efi gcdx64.efi; do \
      [ -e "/boot/efi/EFI/fedora/$f" ] || echo "luma: AVISO: $f ausente; a ISO sairá do bib (reserva)"; \
    done
# iso #36: os modelos do lorax pararam em "symlink ../run/install mnt/install" (FileNotFoundError): na imagem
# atômica /mnt e /media apontam para var/, que não existe na árvore. No instalador (ambiente live, nunca o
# sistema instalado) eles viram diretórios reais; o Anaconda também monta o destino em /mnt/sysroot.
RUN for d in /mnt /media; do \
      if [ -L "$d" ]; then echo "luma: $d era link para $(readlink "$d"); vira diretório"; rm -f "$d"; mkdir -p "$d"; fi; \
    done
# Marca Luma (F6-05): o Anaconda aplica a marca por perfil (/etc/anaconda/profile.d, custom_stylesheet), não por
# troca dos PNGs genéricos (iso #32). O perfil luma é escolhido pelo ID=luma do os-release.
RUN echo "luma: perfil de referência: $(cat /etc/anaconda/profile.d/fedora-silverblue.conf 2>/dev/null | grep -v '^#' | tr '\n' ' ')"
COPY --from=marca /out/ /usr/share/anaconda/pixmaps/luma/
COPY installer/anaconda/luma.css /usr/share/anaconda/pixmaps/luma/luma.css
COPY installer/anaconda/luma.conf /etc/anaconda/profile.d/luma.conf
RUN for f in sidebar-bg.png topbar-bg.png sidebar-logo.png; do \
      test -s "/usr/share/anaconda/pixmaps/luma/$f" && grep -q "pixmaps/luma/$f" /usr/share/anaconda/pixmaps/luma/luma.css \
        || { echo "luma: marca incompleta: $f" >&2; exit 1; }; \
    done; \
    echo "luma: perfil Anaconda luma instalado (luma.css com as 3 imagens)"
