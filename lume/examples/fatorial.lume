# Sem janela: funções, recursão, laços e listas
fn fact(n) {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

let values = []
for i in range(1, 6) {
    values.append(fact(i))
}
print("fatoriais:", values)

let total = 0
let k = 0
while k < len(values) {
    total = total + values[k]
    k = k + 1
}
print("soma:", total, "par?", total % 2 == 0)
